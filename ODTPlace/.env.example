# Copy this file to .env and fill in your local values.
# The real .env file is ignored by Git and should stay local.

# Expo / React Native
EXPO_PUBLIC_API_URL=

# Backend server
PORT=3001
HOST=0.0.0.0
DEBUG=False
SECRET_KEY=change-me

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=odontoprodb
USE_MOCK_DATA=false

# Optional example for external DB providers
# DATABASE_URL=mysql://user:password@host:port/database
